+    /**
+     * Google's recognizer keeps its latest words, not settled yet, apart from the partial
+     * transcript ("android.speech.extra.UNSTABLE_TEXT"). Appending them shows each word as
+     * soon as it is heard, instead of once the next words settle it.
+     */
+    private fun withUnstableText(
+        results: List<Map<String, Any>>,
+        bundle: Bundle?,
+    ): List<Map<String, Any>> {
+        val unstable =
+            bundle
+                ?.getStringArrayList("android.speech.extra.UNSTABLE_TEXT")
+                ?.firstOrNull()
+                ?.trim()
+                .orEmpty()
+        if (unstable.isEmpty()) return results
+        if (results.isEmpty()) {
+            return listOf(
+                mapOf(
+                    "transcript" to unstable,
+                    "confidence" to 0f,
+                    "segments" to listOf<Map<String, Any>>(),
+                ),
+            )
+        }
+        val first = results[0]
+        val stable = first["transcript"]?.toString()?.trim().orEmpty()
+        val transcript = if (stable.isEmpty()) unstable else "$stable $unstable"
+        return listOf(first + ("transcript" to transcript)) + results.drop(1)
+    }
