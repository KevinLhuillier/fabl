# Copy to `apps/mobile/.env` and fill in.
# EXPO_PUBLIC_* variables are inlined in the JS bundle: only public values here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_… or legacy anon key).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys (Project settings → API keys), for the premium subscription.
# Without them the app runs, but the offer screen says subscriptions are unavailable.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
