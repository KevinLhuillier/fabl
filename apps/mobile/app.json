{
  "expo": {
    "name": "Taleway",
    "slug": "taleway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taleway",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.taleway.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {}
    },
    "android": {
      "package": "com.taleway.app",
      "adaptiveIcon": {
        "backgroundColor": "#6C3BE0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C3BE0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Taleway uses the microphone to listen to you read a page aloud and show the words to work on.",
          "speechRecognitionPermission": "Taleway recognizes your speech to follow your reading aloud and show the words to work on."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6cb1a139-1d13-4d9b-9029-84a9253c73e3"
      }
    },
    "owner": "kevinlh"
  }
}
