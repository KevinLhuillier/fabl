{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@publish/*": ["../../scripts/publish/src/*"],
      "@mobile-theme/*": ["../mobile/src/theme/*"]
    }
  },
  "include": ["src", "shared", "vite.config.ts"]
}
