# Copy to `.env` (repo root, used by scripts/publish) and fill in.
# Values: Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_… or legacy service_role): bypasses RLS. Publish script only — NEVER in the app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Python with spaCy + en_core_web_sm. Defaults to the venv in scripts/publish/.venv (see README).
# PYTHON_BIN=python
